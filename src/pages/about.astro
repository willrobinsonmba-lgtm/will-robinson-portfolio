---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'About Will Robinson | Restaurant Marketing Leader';
const pageDescription =
	'Learn about Will Robinson and his work connecting restaurant marketing strategy, digital growth, local-store execution, loyalty, and franchise support.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="about-title">
				<p class="eyebrow">About Will Robinson</p>
				<h1 id="about-title">I believe great marketing should make the business easier to grow.</h1>
				<p class="introduction">
					I’m a restaurant marketing leader who connects strategy, technology, customer
					behavior, and local execution. My work is grounded in a simple idea: marketing
					creates more value when brand priorities become useful actions for operators
					and better experiences for customers.
				</p>
			</section>

			<section class="story" aria-labelledby="story-title">
				<div class="section-heading">
					<p class="section-label">My work</p>
					<h2 id="story-title">From big-picture strategy to store-level reality</h2>
				</div>
				<div class="story-copy">
					<p>
						At Ledo Pizza, my work has spanned restaurant growth, digital strategy,
						local-store marketing, SEO, loyalty, email, online ordering, and franchise
						support. That breadth has taught me to look beyond individual campaigns and
						understand how the entire customer journey works together.
					</p>
					<p>
						I enjoy turning complicated problems into clear priorities. That might mean
						finding friction in an online ordering experience, helping locations become
						more visible in their communities, strengthening customer retention, or
						building programs that franchisees can put into practice.
					</p>
				</div>
			</section>

			<section class="principles" aria-labelledby="principles-title">
				<p class="section-label">How I work</p>
				<h2 id="principles-title">Practical, connected, and accountable</h2>
				<div class="principle-grid">
					<article>
						<p class="number">01</p>
						<h3>Start with the real problem</h3>
						<p>
							Separate symptoms from causes, understand the business context, and focus
							attention where it can make a meaningful difference.
						</p>
					</article>
					<article>
						<p class="number">02</p>
						<h3>Connect the customer experience</h3>
						<p>
							Bring brand, digital channels, stores, loyalty, and communications together
							instead of treating them as unrelated projects.
						</p>
					</article>
					<article>
						<p class="number">03</p>
						<h3>Make strategy usable</h3>
						<p>
							Create tools and programs that work for the people responsible for
							executing them, especially restaurant operators and local teams.
						</p>
					</article>
					<article>
						<p class="number">04</p>
						<h3>Measure what matters</h3>
						<p>
							Use data to clarify performance, improve decisions, and connect marketing
							activity to outcomes the business can understand.
						</p>
					</article>
				</div>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<p class="section-label">What’s next</p>
				<h2 id="closing-title">This portfolio is a growing record of the work, lessons, and results behind that approach.</h2>
				<a href="/#work">Explore my work <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #f5f5f7;
		color: #1d1d1f;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
	}

	main {
		margin: 0 auto;
		max-width: 1200px;
		padding: 0 2rem;
	}

	.hero {
		max-width: 1050px;
		padding: clamp(6rem, 12vw, 10rem) 0 clamp(6rem, 10vw, 9rem);
	}

	.eyebrow,
	.section-label {
		color: #6e6e73;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin: 0 0 1.25rem;
		text-transform: uppercase;
	}

	h1 {
		font-size: clamp(3.25rem, 7.5vw, 7rem);
		font-weight: 700;
		letter-spacing: -0.055em;
		line-height: 0.96;
		margin: 0;
		text-wrap: balance;
	}

	.introduction {
		color: #515154;
		font-size: clamp(1.2rem, 2.2vw, 1.65rem);
		letter-spacing: -0.015em;
		line-height: 1.5;
		margin: 2.25rem 0 0;
		max-width: 800px;
	}

	.story,
	.principles {
		border-top: 1px solid rgba(0, 0, 0, 0.12);
		padding: clamp(5rem, 9vw, 8rem) 0;
	}

	.story {
		display: grid;
		gap: clamp(3rem, 8vw, 8rem);
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}

	h2 {
		font-size: clamp(2.35rem, 5vw, 4.75rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.02;
		margin: 0;
		text-wrap: balance;
	}

	.story-copy {
		padding-top: 2.4rem;
	}

	.story-copy p {
		color: #515154;
		font-size: 1.1rem;
		line-height: 1.7;
		margin: 0 0 1.5rem;
	}

	.principle-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 4rem;
	}

	.principle-grid article {
		border-top: 1px solid rgba(0, 0, 0, 0.12);
		padding: 2.5rem 2.5rem 3rem 0;
	}

	.principle-grid article:nth-child(even) {
		border-left: 1px solid rgba(0, 0, 0, 0.12);
		padding-left: 2.5rem;
	}

	.number {
		color: #86868b;
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
		margin: 0 0 2rem;
	}

	h3 {
		font-size: 1.45rem;
		letter-spacing: -0.025em;
		margin: 0 0 0.8rem;
	}

	.principle-grid article > p:last-child {
		color: #6e6e73;
		line-height: 1.6;
		margin: 0;
		max-width: 470px;
	}

	.closing {
		background: #1d1d1f;
		border-radius: 2rem;
		margin-bottom: 5rem;
		padding: clamp(2.5rem, 7vw, 6rem);
	}

	.closing .section-label {
		color: #a1a1a6;
	}

	.closing h2 {
		color: #f5f5f7;
		max-width: 950px;
	}

	.closing a {
		color: #2997ff;
		display: inline-block;
		font-weight: 600;
		margin-top: 2rem;
		text-decoration: none;
	}

	.closing a:hover {
		text-decoration: underline;
	}

	a:focus-visible {
		border-radius: 6px;
		outline: 3px solid #0071e3;
		outline-offset: 4px;
	}

	@media (max-width: 760px) {
		main {
			padding: 0 1.25rem;
		}

		.story,
		.principle-grid {
			grid-template-columns: 1fr;
		}

		.story-copy {
			padding-top: 0;
		}

		.principle-grid article:nth-child(even) {
			border-left: 0;
			padding-left: 0;
		}

		.closing {
			border-radius: 1.5rem;
		}
	}
</style>
