---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="intro-title">
				<p class="eyebrow">Will Robinson · Restaurant Marketing</p>
				<h1 id="intro-title">I turn restaurant marketing complexity into measurable growth.</h1>
				<p class="introduction">
					I connect brand strategy, digital experience, local-store execution, and
					performance analysis to help restaurant systems grow more effectively.
				</p>
				<div class="hero-links">
					<a class="primary-button" href="#work">Explore my work</a>
					<a class="text-link" href="/about">More about me <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="capabilities" aria-labelledby="capabilities-title">
				<p class="section-label">Capabilities</p>
				<h2 id="capabilities-title">Strategy connected to execution</h2>
				<div class="capability-grid">
					<div>
						<h3>Digital growth</h3>
						<p>Online ordering, conversion analysis, SEO, location experiences, and customer acquisition.</p>
					</div>
					<div>
						<h3>Customer relationships</h3>
						<p>Email, loyalty, offers, customer journeys, and repeat-visit strategy.</p>
					</div>
					<div>
						<h3>Franchise support</h3>
						<p>Practical programs and tools that connect brand priorities with local-store needs.</p>
					</div>
				</div>
			</section>

			<section class="work" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<p class="section-label">Selected work</p>
					<h2 id="work-title">A portfolio built around real restaurant challenges</h2>
					<p>
						These focus areas represent work across Ledo Pizza marketing,
						digital operations, customer engagement, and franchise support.
						Detailed case studies will be added as approved materials are prepared.
					</p>
				</div>

				<div class="project-list">
					<article>
						<p class="project-number">01</p>
						<div>
							<p class="project-category">Digital experience</p>
							<h3>Online ordering and conversion</h3>
							<p>Finding friction in the ordering journey and turning performance data into clearer priorities.</p>
						</div>
					</article>
					<article>
						<p class="project-number">02</p>
						<div>
							<p class="project-category">Local visibility</p>
							<h3>Multi-location SEO and store marketing</h3>
							<p>Improving how restaurant locations appear, communicate, and compete in their local markets.</p>
						</div>
					</article>
					<article>
						<p class="project-number">03</p>
						<div>
							<p class="project-category">Customer retention</p>
							<h3>Loyalty and email strategy</h3>
							<p>Using segmentation, offers, and performance analysis to strengthen customer relationships.</p>
						</div>
					</article>
					<article>
						<p class="project-number">04</p>
						<div>
							<p class="project-category">Brand activation</p>
							<h3>Campaigns and franchise execution</h3>
							<p>Translating brand-level ideas into practical programs that local restaurant operators can use.</p>
						</div>
					</article>
				</div>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<p class="section-label">The next chapter</p>
				<h2 id="closing-title">Building stronger restaurant brands through useful, connected marketing.</h2>
				<a class="closing-link" href="/about">Read about my experience <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		background: #f5f5f7;
		color: #1d1d1f;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
	}

	main {
		margin: 0 auto;
		max-width: 1200px;
		padding: 0 2rem;
	}

	.hero {
		max-width: 1050px;
		padding: clamp(6rem, 12vw, 10rem) 0 clamp(6rem, 10vw, 9rem);
	}

	.eyebrow,
	.section-label,
	.project-category {
		color: #6e6e73;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin: 0 0 1.25rem;
		text-transform: uppercase;
	}

	h1 {
		color: #1d1d1f;
		font-size: clamp(3.25rem, 7.5vw, 7rem);
		font-weight: 700;
		letter-spacing: -0.055em;
		line-height: 0.96;
		margin: 0;
		text-wrap: balance;
	}

	.introduction {
		color: #515154;
		font-size: clamp(1.2rem, 2.2vw, 1.65rem);
		letter-spacing: -0.015em;
		line-height: 1.45;
		margin: 2.25rem 0 0;
		max-width: 760px;
	}

	.hero-links {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 2.75rem;
	}

	.primary-button {
		background: #0071e3;
		border-radius: 999px;
		color: #fff;
		display: inline-flex;
		font-size: 0.95rem;
		font-weight: 650;
		padding: 0.85rem 1.25rem;
		text-decoration: none;
		transition: background-color 140ms ease-out, transform 100ms ease-out;
	}

	.primary-button:hover {
		background: #0077ed;
		color: #fff;
	}

	.primary-button:active {
		transform: scale(0.97);
	}

	.text-link,
	.closing-link {
		color: #0066cc;
		font-weight: 600;
		text-decoration: none;
	}

	.text-link:hover,
	.closing-link:hover {
		text-decoration: underline;
	}

	a:focus-visible {
		border-radius: 6px;
		outline: 3px solid #0071e3;
		outline-offset: 4px;
	}

	.capabilities,
	.work {
		border-top: 1px solid rgba(0, 0, 0, 0.12);
		padding: clamp(5rem, 9vw, 8rem) 0;
	}

	h2 {
		color: #1d1d1f;
		font-size: clamp(2.35rem, 5vw, 4.75rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.02;
		margin: 0;
		text-wrap: balance;
	}

	.capability-grid {
		display: grid;
		gap: 3rem;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 4rem;
	}

	.capability-grid h3,
	.project-list h3 {
		color: #1d1d1f;
		font-size: 1.45rem;
		letter-spacing: -0.025em;
		line-height: 1.15;
		margin: 0 0 0.8rem;
	}

	.capability-grid p,
	.project-list p,
	.section-heading > p {
		color: #6e6e73;
		font-size: 1rem;
		line-height: 1.6;
		margin: 0;
	}

	.section-heading {
		max-width: 900px;
	}

	.section-heading > p {
		font-size: 1.1rem;
		margin-top: 1.75rem;
		max-width: 720px;
	}

	.project-list {
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
		margin-top: 4rem;
	}

	.project-list article {
		align-items: start;
		border-top: 1px solid rgba(0, 0, 0, 0.12);
		display: grid;
		gap: 2rem;
		grid-template-columns: 80px 1fr;
		padding: 2.5rem 0;
	}

	.project-number {
		color: #86868b !important;
		font-size: 0.82rem !important;
		font-variant-numeric: tabular-nums;
	}

	.project-category {
		font-size: 0.7rem;
		margin-bottom: 0.65rem;
	}

	.project-list article > div > p:last-child {
		max-width: 680px;
	}

	.closing {
		background: #1d1d1f;
		border-radius: 2rem;
		color: #fff;
		margin: 0 0 5rem;
		padding: clamp(2.5rem, 7vw, 6rem);
	}

	.closing .section-label {
		color: #a1a1a6;
	}

	.closing h2 {
		color: #f5f5f7;
		max-width: 900px;
	}

	.closing-link {
		color: #2997ff;
		display: inline-block;
		margin-top: 2rem;
	}

	@media (max-width: 760px) {
		main {
			padding: 0 1.25rem;
		}

		.capability-grid {
			gap: 2.5rem;
			grid-template-columns: 1fr;
		}

		.project-list article {
			gap: 1rem;
			grid-template-columns: 1fr;
		}

		.closing {
			border-radius: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}

		.primary-button {
			transition: none;
		}
	}
</style>
